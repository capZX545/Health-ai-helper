[app]
title = NexusMed 2077
package.name = nexusmed
package.domain = com.nexusmed2077
source.dir = .
source.include_exts = py,json,gz,html,css,js,svg,txt,csv,db,ttf,example
version = 2.5.0
requirements = python3,kivy,requests,pillow,setuptools
orientation = portrait
fullscreen = 0
android.archs = arm64-v8a
android.minapi = 24
android.accept_sdk_license = True
android.permissions = INTERNET
log_level = 2
warn_on_root = 1

[buildozer]
log_level = 2
warn_on_root = 1
