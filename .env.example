# نمونه‌ی تنظیمات NexusMed 2077 — این فایل را کپی کنید و نامش را .env بگذارید
# فایل .env واقعی هرگز نباید داخل ZIP یا Setup قرار بگیرد.

# OpenRouter (پیشنهادی — مدل‌های رایگان)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_REASONING_ENABLED=0

# OpenAI
OPENAI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# openFDA (اختیاری)
OPENFDA_API_KEY=
